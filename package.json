    "date-fns": "^4.4.0",
    "reflect-metadata": "^0.2.2",
    "ts-gems": "^4.0.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@panates/eslint-config": "^2.3.4",
    "@panates/eslint-config-ts": "^2.3.4",
    "@panates/rman-preset": "^2.2.1",
    "@panates/tsconfig": "^2.1.8",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@swc/helpers": "^0.5.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "ansi-colors": "^4.1.3",
    "c8": "^12.0.0",
    "expect": "^30.5.2",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "rman": "^2.39.0",
    "typescript": "^6.0.3",
    "yargs": "^18.2.0"
  },
  "scripts": {
    "compile": "tsc --noEmit",
    "test": "mocha",
