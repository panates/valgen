    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/valgen.git"
  },
  "keywords": [
    "validate",
    "validation",
    "validator",
    "check",
    "encoding",
    "decoding",
    "coerce",
    "convert",
    "converter",
    "transform",
    "type"
